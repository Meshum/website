---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Page Not Found - Meshum"
	description="The page you're looking for doesn't exist."
>
	<section class="mesh-bg flex min-h-[70vh] items-center justify-center px-6">
		<div class="mx-auto max-w-lg text-center">
			<p class="font-technical text-xs uppercase tracking-[0.08em] text-subtle">Error</p>
			<p class="mt-4 font-heading text-7xl font-bold text-foreground">404</p>
			<h1 class="mt-4 font-heading text-2xl font-bold text-foreground">
				Page not found
			</h1>
			<p class="mt-3 font-body text-muted">
				The page you're looking for doesn't exist or has been moved.
			</p>
			<a href="/" class="mt-8 inline-block rounded-lg bg-primary px-5 py-2.5 font-body font-medium text-on-primary transition-[filter] hover:brightness-110">
				Back to home
			</a>
		</div>
	</section>
</Layout>
