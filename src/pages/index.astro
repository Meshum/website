---
import Logo from '../../public/logo.svg';
import Layout from "../layouts/Layout.astro";
---

<Layout title="Meshum — Coming Soon" description="Something new is coming. Meshum is being rebuilt from the ground up.">
	<section class="min-h-screen flex items-center justify-center px-6 bg-page">
		<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
			<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/8 rounded-full blur-3xl"></div>
			<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
		</div>

		<div class="relative z-10 text-center max-w-lg mx-auto">
			<div class="flex items-center justify-center mb-10">
				<Logo class="w-16 h-16" />
			</div>

			<h1 class="font-heading text-5xl md:text-6xl font-bold text-foreground mb-4 tracking-tight">
				Meshum
			</h1>

			<p class="font-heading text-xl md:text-2xl font-medium text-primary mb-6">
				Something new is coming.
			</p>

			<p class="font-body text-base text-muted leading-relaxed">
				We're rebuilding Meshum from the ground up.<br />
				Stay tuned.
			</p>
		</div>
	</section>
</Layout>
