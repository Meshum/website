---
import Layout from "../layouts/Layout.astro";
import PermissionMatrix from "../components/PermissionMatrix.astro";
import TopologyDiagram from "../components/TopologyDiagram.astro";
import { GITHUB_URL } from "../constants";

const capabilities = [
	{
		label: "01",
		title: "MCP server registry",
		body: "Register every MCP server your organization runs in one place. See what each one exposes before anyone connects to it.",
	},
	{
		label: "02",
		title: "Tool-level permissions",
		body: "Allow, block, or flag individual tools within a server — not just the server as a whole. A database server's read tool and its delete tool are different decisions.",
	},
	{
		label: "03",
		title: "Skill & agent distribution",
		body: "Publish skills and agents to a catalog your organization pulls from, instead of passing configs around by hand. Update once, roll out everywhere.",
	},
	{
		label: "04",
		title: "Telemetry & audit log",
		body: "Every call through the control plane is recorded — tool, server, caller, outcome. Answer \"what did our AI tools do last week\" without guessing.",
	},
	{
		label: "05",
		title: "Per-team and per-role policy",
		body: "Different teams need different access. Scope policy to a team, a role, or an individual without maintaining a separate deployment for each.",
	},
	{
		label: "06",
		title: "Self-hosted control plane",
		body: "Self-hosted, on your infrastructure. Your policies, telemetry, and credentials never leave your network.",
	},
];
---

<Layout
	title="Features — Meshum"
	description="Governance, distribution, and telemetry for MCP servers, skills, and agents — the capabilities inside Meshum's self-hosted control plane."
>
	<section class="mesh-bg border-b border-border-subtle px-6 py-24">
		<div class="mx-auto max-w-[1200px] text-center">
			<p class="font-technical text-xs uppercase tracking-[0.08em] text-subtle">Features</p>
			<h1 class="mx-auto mt-6 max-w-[24ch] font-heading text-[clamp(2.25rem,4vw,3.25rem)] font-bold leading-[1.1] tracking-[-0.02em] text-foreground">
				Everything your platform team needs to govern AI tooling
			</h1>
			<p class="mx-auto mt-6 max-w-[55ch] font-body text-lg leading-[1.55] text-muted">
				One control plane, deployed on your infrastructure, sitting between your
				people and every MCP server, skill, and agent they use.
			</p>
		</div>
	</section>

	<section class="border-b border-border-subtle bg-page px-6 py-24">
		<div class="mx-auto max-w-[1200px]">
			<div class="reveal grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					capabilities.map((cap) => (
						<div class="rounded-xl border border-border bg-surface p-8">
							<p class="font-technical text-xs text-subtle">{cap.label}</p>
							<h3 class="mt-4 font-heading text-xl font-medium leading-[1.25] tracking-[-0.01em] text-foreground">
								{cap.title}
							</h3>
							<p class="mt-3 font-body text-[0.9375rem] leading-[1.55] text-muted">{cap.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="border-b border-border-subtle bg-surface px-6 py-24">
		<div class="mx-auto max-w-[1200px]">
			<div class="reveal mx-auto max-w-[60ch] text-center">
				<p class="font-technical text-xs uppercase tracking-[0.08em] text-subtle">Governance in practice</p>
				<h2 class="mt-4 font-heading text-[clamp(1.75rem,3vw,2.5rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-foreground">
					Permissions that match how tools actually get misused
				</h2>
				<p class="mt-4 font-body text-lg leading-[1.55] text-muted">
					Most incidents don't come from the tool being present — they come from
					the tool being able to do more than it should have been allowed to.
				</p>
			</div>
			<div class="reveal mx-auto mt-12 max-w-[720px]">
				<PermissionMatrix />
			</div>
		</div>
	</section>

	<section class="border-b border-border-subtle bg-page px-6 py-24">
		<div class="mx-auto max-w-[1200px]">
			<div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:items-center">
				<div class="reveal md:col-span-7">
					<div class="overflow-hidden rounded-lg border border-border bg-surface">
						<div class="flex items-center justify-between border-b border-border-subtle px-4 py-2.5">
							<span class="font-technical text-xs text-subtle">incident-triage &middot; skill</span>
							<span class="font-technical text-xs text-success">✓ distributed</span>
						</div>
						<div class="p-5 font-technical text-[0.8125rem] leading-relaxed">
							<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
								<span class="text-foreground">requires</span>
								<span class="text-subtle">— checked against team policy</span>
							</div>
							<ul class="mt-3 space-y-0">
								<li class="flex items-center justify-between gap-3 border-t border-border-subtle py-2.5">
									<span class="text-foreground">pagerduty <span class="text-subtle">/ read</span></span>
									<span class="text-success">allowed</span>
								</li>
								<li class="flex items-center justify-between gap-3 border-t border-border-subtle py-2.5">
									<span class="text-foreground">github <span class="text-subtle">/ read</span></span>
									<span class="text-success">allowed</span>
								</li>
								<li class="flex items-center justify-between gap-3 border-t border-border-subtle py-2.5">
									<span class="text-foreground">github <span class="text-subtle">/ write</span></span>
									<span class="text-success">allowed</span>
								</li>
							</ul>
							<div class="mt-4 flex flex-wrap items-center gap-2 border-t border-border-subtle pt-4 text-xs text-subtle">
								<span>distributed to</span>
								<span class="rounded-md border border-border px-2 py-0.5 text-foreground">platform</span>
								<span class="rounded-md border border-border px-2 py-0.5 text-foreground">on-call</span>
							</div>
						</div>
					</div>
				</div>
				<div class="reveal md:col-span-5 md:col-start-8">
					<p class="font-technical text-xs uppercase tracking-[0.08em] text-subtle">Distribution</p>
					<h2 class="mt-4 font-heading text-[clamp(1.75rem,3vw,2.5rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-foreground">
						A skill declares what it needs. Meshum checks it against policy.
					</h2>
					<p class="mt-4 max-w-[50ch] font-body text-lg leading-[1.55] text-muted">
						Skills and agents declare the servers and tools they depend on.
						Meshum won't distribute a skill to a team whose policy doesn't
						already allow what it asks for.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="border-b border-border-subtle bg-surface px-6 py-24">
		<div class="mx-auto max-w-[1200px]">
			<div class="grid grid-cols-1 gap-12 md:grid-cols-12 md:items-center">
				<div class="reveal md:col-span-5">
					<p class="font-technical text-xs uppercase tracking-[0.08em] text-subtle">Architecture</p>
					<h2 class="mt-4 font-heading text-[clamp(1.75rem,3vw,2.5rem)] font-semibold leading-[1.15] tracking-[-0.015em] text-foreground">
						Your infrastructure, your control plane
					</h2>
					<p class="mt-4 max-w-[50ch] font-body text-lg leading-[1.55] text-muted">
						Meshum is self-hosted. It sits between your people and every MCP
						server, skill, and agent — enforcing policy and recording telemetry
						on every call.
					</p>
				</div>
				<div class="reveal md:col-span-7">
					<TopologyDiagram />
				</div>
			</div>
		</div>
	</section>

	<section class="gradient-cta px-6 py-32">
		<div class="mx-auto max-w-[1200px] text-center">
			<h2 class="mx-auto max-w-[24ch] font-heading text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.1] tracking-[-0.02em] text-white">
				Read the source, run it yourself.
			</h2>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
				<a
					href={GITHUB_URL}
					class="rounded-lg bg-white px-5 py-2.5 font-body font-medium text-accent transition-[filter] hover:brightness-95"
				>
					View on GitHub
				</a>
			</div>
		</div>
	</section>
</Layout>
