---
import Logo from "../assets/meshum-logo.svg";
import { GITHUB_URL, VERSION } from "../constants";

const year = new Date().getFullYear();

const columns = [
	{
		heading: "Product",
		links: [
			{ href: "/features", label: "Features" },
			{ href: GITHUB_URL, label: "Source" },
			{ href: `${GITHUB_URL}/releases`, label: "Releases" },
		],
	},
	{
		heading: "Company",
		links: [
			{ href: "/about", label: "About" },
			{ href: `${GITHUB_URL}/blob/master/LICENSE.md`, label: "License", target: '_blank' },
		],
	},
	{
		heading: "Resources",
		links: [
			{ href: `${GITHUB_URL}#readme`, label: "Documentation" },
			{ href: `${GITHUB_URL}/issues`, label: "Issue tracker" },
			{ href: `${GITHUB_URL}/discussions`, label: "Discussions" },
		],
	},
];
---

<footer class="mesh-bg border-t border-border-subtle bg-surface">
	<div class="mx-auto max-w-[1200px] px-6 py-16">
		<div class="grid grid-cols-2 gap-10 md:grid-cols-5">
			<div class="col-span-2">
				<a href="/" class="flex items-center gap-2.5 font-heading text-lg font-bold text-foreground">
					<Logo class="h-6 w-auto" />
					Meshum
				</a>
				<p class="mt-4 max-w-[32ch] font-body text-sm text-muted">
					The AI platform team, productized.
				</p>
			</div>

			{
				columns.map((col) => (
					<div>
						<p class="font-technical text-xs font-medium uppercase tracking-[0.08em] text-subtle">
							{col.heading}
						</p>
						<ul class="mt-4 flex flex-col gap-3">
							{col.links.map((link) => (
								<li>
									<a
									href={link.href}
									target={link.target}
									rel={link.target === "_blank" ? "noopener noreferrer" : undefined}
									class="font-body text-sm text-muted transition-colors hover:text-foreground"
								>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="mt-16 flex flex-col gap-4 border-t border-border-subtle pt-8 font-technical text-xs text-subtle sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {year} Meshum. All rights reserved.</p>
			<div class="flex flex-wrap items-center gap-2">
				<span class="rounded-md border border-border px-2 py-0.5">AGPL-3.0-or-later</span>
				<span class="rounded-md border border-border px-2 py-0.5">commercial license available</span>
				<span class="rounded-md border border-border px-2 py-0.5">v{VERSION}</span>
			</div>
		</div>
	</div>
</footer>
