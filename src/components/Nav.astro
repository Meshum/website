---
import Logo from "../assets/meshum-logo.svg";

const GITHUB_URL = "https://github.com/meshum/meshum";

const links = [
	{ href: "/", label: "Home" },
	{ href: "/features", label: "Features" },
	{ href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<header id="site-nav" class="sticky top-0 z-50 h-16 border-b border-transparent">
	<div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6">
		<a href="/" class="flex items-center gap-2.5 font-heading text-lg font-bold text-foreground">
			<Logo class="h-6 w-auto" />
			Meshum
		</a>

		<nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
			{
				links.map((link) => {
					const isActive = currentPath === link.href;
					return (
						<a
							href={link.href}
							class:list={[
								"font-body text-sm font-medium transition-colors",
								isActive ? "text-foreground" : "text-muted hover:text-foreground",
							]}
							aria-current={isActive ? "page" : undefined}
						>
							{link.label}
						</a>
					);
				})
			}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={GITHUB_URL}
				class="hidden items-center gap-2 rounded-lg bg-primary px-4 py-2 font-body text-sm font-medium text-on-primary transition-[filter] hover:brightness-110 sm:flex"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.5 0-.24-.01-1.04-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.46-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05a9.32 9.32 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.71 1.03 1.62 1.03 2.74 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.81 0 .27.18.6.69.5C19.14 20.62 22 16.77 22 12.25 22 6.58 17.52 2 12 2Z"/></svg>
				GitHub
			</a>

			<button id="nav-toggle" type="button" class="grid h-9 w-9 place-items-center rounded-lg border border-border text-foreground md:hidden" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M3 6h18M3 12h18M3 18h18"/></svg>
			</button>
		</div>
	</div>

	<div id="mobile-nav" class="hidden border-b border-border bg-elevated md:hidden">
		<nav class="flex flex-col gap-1 px-6 py-4" aria-label="Mobile">
			{
				links.map((link) => {
					const isActive = currentPath === link.href;
					return (
						<a
							href={link.href}
							class:list={[
								"rounded-lg px-3 py-3 font-heading text-lg font-medium hover:bg-surface",
								isActive ? "text-foreground underline decoration-primary underline-offset-4" : "text-muted",
							]}
							aria-current={isActive ? "page" : undefined}
						>
							{link.label}
						</a>
					);
				})
			}
			<a href={GITHUB_URL} class="mt-2 rounded-lg bg-primary px-3 py-3 text-center font-body text-sm font-medium text-on-primary">
				View on GitHub
			</a>
		</nav>
	</div>
</header>

<script is:inline>
	(function () {
		var navToggle = document.getElementById("nav-toggle");
		var mobileNav = document.getElementById("mobile-nav");
		navToggle?.addEventListener("click", function () {
			var isHidden = mobileNav.classList.toggle("hidden");
			navToggle.setAttribute("aria-expanded", String(!isHidden));
		});

		var nav = document.getElementById("site-nav");
		function onScroll() {
			nav.classList.toggle("border-border-subtle", window.scrollY > 8);
			nav.classList.toggle("bg-page/80", window.scrollY > 8);
			nav.classList.toggle("backdrop-blur", window.scrollY > 8);
		}
		document.addEventListener("scroll", onScroll, { passive: true });
		onScroll();
	})();
</script>
